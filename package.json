{
  "name": "hm-automation-playwright-cucumber",
  "version": "1.0.0",
  "description": "Framework d'automatisation de tests E2E pour H&M avec Playwright, TypeScript, Cucumber BDD et Page Object Model",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env CROSS_ENV_HEADLESS=false SLOW_MO=1000 cucumber-js",
    "test:country": "cucumber-js --tags \"@country\"",
    "test:country:headed": "cross-env CROSS_ENV_HEADLESS=false SLOW_MO=1500 cucumber-js --tags \"@country\"",
    "test:auth": "cucumber-js --tags \"@auth\"",
    "test:cart": "cucumber-js --tags \"@cart or @search\"",
    "test:favorites": "cucumber-js --tags \"@favorites\"",
    "test:report": "cucumber-js --format html:outputs/reports/cucumber-report.html",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "typescript",
    "e2e-testing",
    "page-object-model",
    "hm"
  ],
  "author": "QA Automation Engineer",
  "license": "ISC",
  "dependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "cross-env": "^10.1.0"
  }
}
